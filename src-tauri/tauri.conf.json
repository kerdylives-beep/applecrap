{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppleCrap Alpha",
  "version": "0.2.0-alpha.1",
  "identifier": "com.kerdylives.applecrap.alpha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AppleCrap Alpha",
        "width": 720,
        "height": 1240,
        "minWidth": 560,
        "minHeight": 820,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://itunes.apple.com https://music.apple.com; img-src 'self' https: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256"
    },
    "icon": [
      "../build/icons/applecrap-icon.png",
      "../build/icons/applecrap-icon.ico"
    ]
  }
}
