{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core access and app commands for the main dashboard window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-bootstrap-app",
    "allow-save-settings",
    "allow-connect-bot",
    "allow-disconnect-bot",
    "allow-enqueue-manual-request",
    "allow-remove-request",
    "allow-clear-queue",
    "allow-search-apple-music",
    "allow-open-track",
    "allow-run-probe",
    "allow-run-automation-step",
    "allow-dispatch-next-request",
    "allow-approve-request",
    "allow-send-request-to-manual-review",
    "allow-set-dispatch-hotkey",
    "allow-export-diagnostics",
    "allow-reveal-data-folder",
    "allow-import-legacy-state",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-start-drag",
    "allow-player-show",
    "allow-player-hide"
  ]
}
